#!/usr/bin/env bash
set -euo pipefail

# PRIVATE.md holds local-only notes and must never reach the public repository.
private=$(git ls-files --cached | grep -E '(^|/)PRIVATE\.md$' || true)
if [ -n "$private" ]; then
  echo "Refusing to commit private notes:" >&2
  echo "$private" >&2
  echo "Unstage with: git rm --cached <file>" >&2
  exit 1
fi

npm run --silent lint
npm test --silent
